<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App-specific palette. Most control styling (Button, ComboBox, Menu, TextBox,
         etc.) comes from WPF-UI's ui:ThemesDictionary/ui:ControlsDictionary, merged
         ahead of this file in App.xaml. WPF-UI ships its own ListView type, though,
         so the plain System.Windows.Controls.ListView/GridView this app uses for the
         mission catalog falls back to the default (light) Aero2 chrome unless styled
         here explicitly. -->
    <Color x:Key="PanelColor">#FF252526</Color>
    <Color x:Key="ControlColor">#FF2D2D30</Color>
    <Color x:Key="ControlBorderColor">#FF3F3F46</Color>
    <Color x:Key="ForegroundColor">#FFE0E0E0</Color>
    <Color x:Key="MutedForegroundColor">#FF9A9A9A</Color>
    <Color x:Key="SelectionColor">#FF3A3D41</Color>

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlColor}"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
    </Style>

    <!-- ListViewItem's built-in Aero2 chrome ignores plain Background setters for its
         selected/hover states, so it gets a real ControlTemplate that renders the
         GridView columns itself. -->
    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

</ResourceDictionary>
