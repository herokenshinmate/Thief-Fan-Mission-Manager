<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App-specific palette. Control styling itself (Button, ComboBox, Menu, ListView,
         etc.) comes from WPF-UI's ui:ThemesDictionary/ui:ControlsDictionary, merged
         ahead of this file in App.xaml. This dictionary only keeps the few brushes
         our own XAML still references directly (e.g. muted description text). -->
    <Color x:Key="MutedForegroundColor">#FF9A9A9A</Color>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}"/>

</ResourceDictionary>
