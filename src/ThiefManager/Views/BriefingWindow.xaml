<ui:FluentWindow x:Class="ThiefManager.Views.BriefingWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Mission Briefing" Width="720" Height="720" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Mission Briefing" FontFamily="Cambria" FontSize="15" FontWeight="SemiBold">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="BookOpen24" FontSize="16"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#33E53935" BorderBrush="#FFE53935" BorderThickness="1" CornerRadius="4"
                    Padding="10,8" Margin="0,0,0,12"
                    Visibility="{Binding VersionWarning, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24" Foreground="#FFE53935" Margin="0,0,8,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding VersionWarning, ElementName=Root}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1" Text="{Binding Title}" FontFamily="Cambria" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Visibility="{Binding Notes, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Info24" Foreground="#FFC9A227" Margin="0,0,6,0"/>
                            <TextBlock Text="Notes" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="BookOpen24" Foreground="#FFBA68C8" Margin="0,0,6,0"/>
                            <TextBlock Text="Briefing" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Padding="14,6"/>
                <ui:Button Content="Play" Click="Play_Click" Appearance="Success" Padding="18,6">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Play24" Filled="True"/>
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
