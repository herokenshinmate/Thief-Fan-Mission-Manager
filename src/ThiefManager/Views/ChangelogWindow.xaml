<ui:FluentWindow x:Class="ThiefManager.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThiefManager"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Changelog" Width="560" Height="640" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Changelog" FontFamily="Cambria" FontSize="15" FontWeight="SemiBold">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="16"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="16" ItemsSource="{x:Static local:ChangelogData.Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ChangelogEntry}">
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="TagMultiple24" Foreground="#FFC9A227" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Date}" Foreground="{StaticResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Changes}" Margin="32,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="0,0,0,1" Margin="0,16,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
