<ui:FluentWindow x:Class="ThiefManager.Views.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Scan for New Missions" Width="820" Height="620" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Scan for New Missions" FontFamily="Cambria" FontSize="15" FontWeight="SemiBold">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="FolderSearch24" FontSize="16"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <DockPanel Grid.Row="1" Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Scan Results" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ui:Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" Margin="12,0,0,0" Padding="8,2">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24"/>
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="Both games' configured FM folders and Downloads folders were scanned. Check the missions you want to add, edit the title if needed, then click Import Selected."
                   Foreground="{StaticResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ScanError}" Foreground="#FFE05252" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ui:Button DockPanel.Dock="Bottom" Content="Import Selected" Command="{Binding ImportSelectedCommand}"
                HorizontalAlignment="Right" Width="160" Margin="0,12,0,0">
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="ArrowDownload24"/>
            </ui:Button.Icon>
        </ui:Button>

        <ListView x:Name="CandidatesListView" BorderThickness="0" Background="Transparent"
                  VirtualizingPanel.IsVirtualizing="False"
                  ScrollViewer.CanContentScroll="False"
                  MouseRightButtonUp="CandidatesListView_MouseRightButtonUp">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Ignore" Click="IgnoreCandidate_Click"
                            ToolTip="Hide this mission from future scans until removed from the Ignore List.">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="EyeOff24"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <ui:CardExpander IsExpanded="True" ContentPadding="12,4,12,8">
                                            <ui:CardExpander.Header>
                                                <StackPanel Orientation="Horizontal" Margin="4,2,0,2">
                                                    <Grid Width="20" Height="20" Margin="0,0,8,0">
                                                        <ui:SymbolIcon Symbol="Games24" Foreground="{Binding Name.Game, Converter={StaticResource GameTitleToBrushConverter}}"/>
                                                        <Image Source="{Binding Name.Game, Converter={StaticResource GameTitleToIconSourceConverter}}" Stretch="Uniform"/>
                                                    </Grid>
                                                    <ui:SymbolIcon Symbol="{Binding Name.IsDownload, Converter={StaticResource BoolToScanTypeIconConverter}}"
                                                                   Foreground="{Binding Name.Game, Converter={StaticResource GameTitleToBrushConverter}}"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=({0})}"
                                                               Foreground="{StaticResource MutedForegroundBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:CardExpander.Header>
                                            <ItemsPresenter Margin="4,4,4,0"/>
                                        </ui:CardExpander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ui:SymbolIcon Symbol="{Binding IsDownload, Converter={StaticResource BoolToScanTypeIconConverter}}"
                                       Foreground="{Binding Game, Converter={StaticResource GameTitleToBrushConverter}}"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SuggestedTitle}" Width="480"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
