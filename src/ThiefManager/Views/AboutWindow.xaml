<ui:FluentWindow x:Class="ThiefManager.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThiefManager"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="About" Width="380" SizeToContent="Height" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="About" FontFamily="Cambria" FontSize="15" FontWeight="SemiBold">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Info24" FontSize="16"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/AppIcon.ico" Width="64" Height="64" Margin="0,0,0,12"/>
            <TextBlock Text="Thief FM Manager" FontFamily="Cambria" FontWeight="SemiBold" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Source={x:Static local:AppVersion.Current}, StringFormat='v{0}'}" FontFamily="Cambria"
                       Foreground="{StaticResource MutedForegroundBrush}" HorizontalAlignment="Center" Margin="0,2,0,12"/>
            <TextBlock Text="A catalog for Thief 1 and Thief 2 fan missions — ratings, play status, install tracking, and Thief Guild metadata lookup, all in one place."
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12" MaxWidth="300"/>
            <TextBlock Text="Built with WPF-UI and CommunityToolkit.Mvvm." Foreground="{StaticResource MutedForegroundBrush}" FontSize="11"
                       TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
