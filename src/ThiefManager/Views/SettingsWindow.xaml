<ui:FluentWindow x:Class="ThiefManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Settings" Width="560" SizeToContent="Height" MinHeight="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings"/>

        <StackPanel Grid.Row="1" Margin="16">
        <TextBlock Text="Thief 1 FM Folder" Margin="0,0,0,4"/>
        <TextBlock Text="The folder where your Thief 1 fan missions are installed (used by loaders like FMSel/NewDarkLoader). Example: C:\Games\Thief1\FMs"
                   Foreground="{StaticResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Browse..." Width="90" Margin="8,0,0,0" Click="BrowseThief1FmFolder_Click"/>
            <TextBox Text="{Binding Thief1FmFolder}"/>
        </DockPanel>

        <TextBlock Text="Thief 1 Executable" Margin="0,0,0,4"/>
        <TextBlock Text="The game (or loader) executable that launches Thief 1. Example: C:\Games\Thief1\Thief.exe"
                   Foreground="{StaticResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Browse..." Width="90" Margin="8,0,0,0" Click="BrowseThief1ExePath_Click"/>
            <TextBox Text="{Binding Thief1ExePath}"/>
        </DockPanel>

        <TextBlock Text="Thief 2 FM Folder" Margin="0,0,0,4"/>
        <TextBlock Text="The folder where your Thief 2 fan missions are installed (used by loaders like FMSel/NewDarkLoader). Example: C:\Games\Thief2\FMs"
                   Foreground="{StaticResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Browse..." Width="90" Margin="8,0,0,0" Click="BrowseThief2FmFolder_Click"/>
            <TextBox Text="{Binding Thief2FmFolder}"/>
        </DockPanel>

        <TextBlock Text="Thief 2 Executable" Margin="0,0,0,4"/>
        <TextBlock Text="The game (or loader) executable that launches Thief 2. Example: C:\Games\Thief2\Thief2.exe"
                   Foreground="{StaticResource MutedForegroundBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Browse..." Width="90" Margin="8,0,0,0" Click="BrowseThief2ExePath_Click"/>
            <TextBox Text="{Binding Thief2ExePath}"/>
        </DockPanel>

        <Button Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Width="100" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
